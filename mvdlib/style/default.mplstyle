# The lab's default Matplotlib style.
#
# Colours must match mvdlib/style/colors.py (checked by the test suite).


# Color

## Text
text.color: "#30343A"
axes.labelcolor: "#30343A"
xtick.labelcolor: "#30343A"
ytick.labelcolor: "#30343A"

## Edges
axes.edgecolor: "#30343A"
patch.edgecolor: "#30343A"
legend.edgecolor: "#30343A"

## Ticks
xtick.color: "#30343A"
ytick.color: "#30343A"

## Lines
axes.prop_cycle: cycler("color", ["#236DA6", "#8E274B", "#079281", "#BC8C06"])
grid.color: "#E9E9E9"
hatch.color: "#30343A"

## Colormaps (registered on import of mvdlib.style)
image.cmap: mvdlib_seq


# Font
font.size: 9
font.family: sans-serif
font.sans-serif: Fira Sans, Helvetica, Arial, DejaVu Sans

## Typeset math in the text font.
mathtext.fontset: custom
mathtext.rm: Fira Sans
mathtext.it: Fira Sans:italic
mathtext.bf: Fira Sans:bold
mathtext.sf: Fira Sans
mathtext.bfit: Fira Sans:italic:bold
mathtext.cal: Fira Sans:italic
mathtext.tt: DejaVu Sans Mono
mathtext.fallback: stixsans


# Axes
axes.autolimit_mode: data
axes.axisbelow: True
axes.formatter.limits: -3, 4
axes.formatter.use_mathtext: True
axes.labelpad: 1.5
axes.linewidth: 0.6
axes.spines.right: False
axes.spines.top: False
axes.xmargin: 0.02
axes.ymargin: 0.02
axes.zmargin: 0.02


# Ticks
xtick.direction: out
xtick.major.pad: 1.5
xtick.major.width: 0.6
xtick.minor.width: 0.5

ytick.direction: out
ytick.major.pad: 1.5
ytick.major.width: 0.6
ytick.minor.width: 0.5


# Grid
axes.grid: True
grid.linestyle: -
grid.linewidth: 0.5


# Lines and markers
lines.linewidth: 1.0
lines.markersize: 4
patch.linewidth: 0.6
errorbar.capsize: 2


# Figure
## Constrained layout fits plain plt.subplots figures to their size.
## mvdlib.plots.subplots replaces it with fixed-size panels.
figure.autolayout: False
figure.constrained_layout.use: True
figure.dpi: 140
figure.labelsize: medium
figure.titlesize: medium
figure.titleweight: bold


# Export
savefig.dpi: 600
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none


# Title
axes.titlelocation: left
axes.titlepad: 6.0
axes.titlesize: medium
axes.titleweight: bold


# Misc
hist.bins: auto
pcolor.shading: auto


# Contour Plots
contour.negative_linestyle: dashed
contour.linewidth: 0.6


# Legends
legend.columnspacing: 1.0
legend.frameon: False
legend.handleheight: 0.5
legend.handlelength: 1.5
legend.handletextpad: 0.6
legend.labelspacing: 0.2
legend.fontsize: 8
